{
  "name": "dominservice/laravel-media-kit",
  "description": "Laravel media library for reusable image and video assets, responsive image variants and admin media management.",
  "type": "library",
  "keywords": ["laravel", "media-library", "responsive-images", "webp", "avif"],
  "homepage": "https://github.com/dominservice/laravel-media-kit",
  "license": "MIT",
  "authors": [
    {
      "name": "Mateusz Domin",
      "email": "biuro@dominsoftware.it",
      "role": "Developer",
      "homepage": "https://dominsoftware.it/"
    }
  ],
  "support": {
    "source": "https://github.com/dominservice/laravel-media-kit",
    "issues": "https://github.com/dominservice/laravel-media-kit/issues"
  },
  "require": {
    "php": "^8.3",
    "illuminate/support": "^13.32",
    "illuminate/filesystem": "^13.32",
    "illuminate/database": "^13.32",
    "illuminate/view": "^13.32",
    "illuminate/routing": "^13.32",
    "rosell-dk/webp-convert": "^2.9.5"
  },
  "require-dev": {
    "orchestra/testbench": "^11.3",
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "Dominservice\\MediaKit\\": "src/",
      "Dominservice\\MediaKit\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dominservice\\MediaKit\\MediaKitServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "ext-gd": "Przyspiesza przetwarzanie obrazów (opcjonalne).",
    "ext-imagick": "Lepsza jakość i wydajność (opcjonalne)."
  },
  "scripts": {
    "test": "vendor/bin/phpunit -c phpunit.xml.dist"
  }
}
